# Configuración de compilación de la app Lazarus.
#
# Copiar a .env (no se versiona) y completar:
#   cp .env.example .env
#   flutter run --dart-define-from-file=.env
#   flutter build apk --release --build-number=<N> --dart-define-from-file=.env
#
# Son valores de compilación (String.fromEnvironment), no secretos: la clave del
# servicio de IA vive solo en el backend y nunca va aquí.

# URL base HTTP del backend; el WebSocket se deriva solo (ws(s)://…/ws/live).
# Vacía = http://localhost:8000. Emulador Android: http://10.0.2.2:8000.
# Teléfono por la LAN: http://<IP-DEL-PC>:8000. Piloto: la URL https del backend.
BACKEND_URL=

# true en los APK del piloto: guarda lazarus.log, GPS, notas y fotos en el
# teléfono (cubierto solo por el consentimiento del piloto). En depuración ya
# está activo. Vacía = false.
FIELD_EVIDENCE=
